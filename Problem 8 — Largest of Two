#include <iostream>
using namespace std;

int main() {
    int a, b;
    cin >> a >> b;

    if (a > b) {
        cout << a;
    }

    return 0;
}

#include <iostream>
using namespace std;

int main() {
    int a, b;
    cin >> a >> b;

    if (a > b) {
        cout << a;
    } else {
        cout << b;
    }

    return 0;
}
#include <iostream>
using namespace std;

int main() {
    int a, b;
    cin >> a >> b;

    if (a > b) {
        cout << a;
    } else if (b > a) {
        cout << b;
    } else {
        cout << "Equal";
    }

    return 0;
}
#include <iostream>
using namespace std;

int main() {
    int a, b;
    cin >> a >> b;

    switch (a > b) {
        case 1:
            cout << a;
            break;
        case 0:
            cout << b;
            break;
    }

    return 0;
}
#include <iostream>
using namespace std;

int main() {
    int a, b;
    cin >> a >> b;

    if (a != b) {
        if (a > b) {
            cout << a;
        }
    }

    return 0;
}
