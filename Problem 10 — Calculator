#include <iostream>
using namespace std;

int main() {
    int a, b, choice;
    cin >> a >> b >> choice;

    if (choice == 1) {
        cout << a + b;
    }

    return 0;
}

#include <iostream>
using namespace std;

int main() {
    int a, b, choice;
    cin >> a >> b >> choice;

    if (choice == 1) {
        cout << a + b;
    } else {
        cout << a - b;
    }

    return 0;
}

#include <iostream>
using namespace std;

int main() {
    int a, b, choice;
    cin >> a >> b >> choice;

    if (choice == 1) {
        cout << a + b;
    } else if (choice == 2) {
        cout << a - b;
    } else {
        cout << "Invalid Choice";
    }

    return 0;
}

#include <iostream>
using namespace std;

int main() {
    int a, b, choice;
    cin >> a >> b >> choice;

    switch (choice) {
        case 1:
            cout << a + b;
            break;
        default:
            cout << a - b;
            break;
    }

    return 0;
}

#include <iostream>
using namespace std;

int main() {
    int a, b, choice;
    cin >> a >> b >> choice;

    if (choice == 1 || choice != 1) {
        if (choice == 1) {
            cout << a + b;
        }
    }

    return 0;
} 
